# ------------------------------------------------------------------------------
# PATH & FPATH Ordering
# ------------------------------------------------------------------------------
# This config ensures CLI tools from different sources don't conflict.
#
# Priority (highest → lowest):
# 1. nvim Mason binaries (~/.local/share/nvim/mason/bin) — editor-managed LSPs/formatters
# 2. Cargo binaries (~/.cargo/bin) — rustup/cargo-installed tools
# 3. User-local binaries (~/.local/bin) — uv tool installs, pipx, etc. (critical for basedpyright)
# 4. Go binaries ($GOPATH/bin) — go install tools
# 5. Homebrew binaries ($HOMEBREW_PREFIX/{bin,sbin}) — package manager (set below)
# 6. System PATH — default fallback (lowest priority)
#
# Rationale:
# - Mason first: ensure nvim's pinned tool versions override brew/system.
# - Cargo before brew: prefer cargo-installed versions when both exist.
# - ~/.local/bin: uv installs here by default; must be before brew/system.
# - $GOPATH/bin: go-installed CLIs should take precedence as needed.
# - Homebrew after user installs to avoid shadowing explicit installs.
# - typeset -U deduplicates path/fpath to avoid repeated entries.
# ------------------------------------------------------------------------------

# Keep PATH and FPATH entries unique (no duplicates)
typeset -U path PATH fpath FPATH
# Tool Flags & Compilers

# ==============================================================================
# SOURCE DOTFILES & MODULES
# ==============================================================================
# Load general personal zsh files
setopt local_options nullglob
local zsh_files=("$HOME/.dotfiles/zsh"/*.zsh)
for file in "${zsh_files[@]}"; do
	[[ -r "$file" ]] && source -- "$file"
done
unsetopt local_options nullglob

# Load local overrides (*.zsh)
if [[ -d "$HOME/.dotfiles/zsh/local" ]]; then
	setopt local_options nullglob
	local local_files=("$HOME/.dotfiles/zsh/local"/*.zsh)
	for file in "${local_files[@]}"; do
		[[ -r "$file" ]] && source -- "$file"
	done
	unsetopt local_options nullglob
fi

# Jira commands live in zsh/jira. Each filename is the command name.
# autoload does not replace a function that is already defined, so drop the
# directory's commands on every zshrc source and `src` picks up new files.
# The loader is a function so its loop variable stays local. A top-level
# `local jira_file` with no value reprints the previous path on the next src.
_jira_register_cmds() {
	[[ -d "$HOME/.dotfiles/zsh/jira" ]] || return 0
	fpath=("$HOME/.dotfiles/zsh/jira" $fpath)
	setopt local_options nullglob
	local -a jira_cmds=()
	local jira_file
	for jira_file in "$HOME/.dotfiles/zsh/jira"/*; do
		[[ -f "$jira_file" ]] || continue
		jira_cmds+=("${jira_file:t}")
	done
	if (( ${#jira_cmds} )); then
		unfunction "${jira_cmds[@]}" 2>/dev/null
		autoload -Uz "${jira_cmds[@]}"
	fi
	alias show_ticket='describe_ticket'
}
unset jira_file jira_cmds
_jira_register_cmds
unfunction _jira_register_cmds

# Completion Styles
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # Case-insensitive
zstyle ':completion:*' menu select                        # Interactive menu

# Directory Colors
if [[ -f "$HOME/.dircolors" ]]; then
	eval "$(gdircolors -b "$HOME/.dircolors")"
fi

# Force vertical bar cursor on prompt reset (\e[5 q = blinking bar, \e[6 q = steady bar)
_force_line_cursor() {
	echo -ne '\e[6 q'
}

precmd_functions+=(_force_line_cursor)

export PROMPT='%F{248}%D{%m/%d} %F{244}%* %F{39}%~ %F{13}%# %f'

# set tools like git to use nvim
export EDITOR="nvim"
export VISUAL="nvim"

# ==============================================================================
# ZSH PLUGINS & COMPLETIONS (OS-Agnostic: macOS, Rocky Linux, Ubuntu)
# ==============================================================================

# 1. Fast, Subshell-Free Homebrew Initialization
if [[ -d "/opt/homebrew" ]]; then
	HOMEBREW_PREFIX="/opt/homebrew"
elif [[ -d "/usr/local/Homebrew" || -d "/usr/local/Cellar" ]]; then
	HOMEBREW_PREFIX="/usr/local"
elif [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
	HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
fi

if [[ -n "$HOMEBREW_PREFIX" ]]; then
	export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
	# Homebrew Python version exposed as python/python3/pip/pip3 via libexec/bin.
	# Single source of truth for the shell; keep in sync with the Brewfile.
	HOMEBREW_PYTHON_VERSION=3.14
	if [[ -d "$HOMEBREW_PREFIX/opt/python@${HOMEBREW_PYTHON_VERSION}/libexec/bin" ]]; then
		export PATH="$HOMEBREW_PREFIX/opt/python@${HOMEBREW_PYTHON_VERSION}/libexec/bin:$PATH"
	fi
	export MANPATH="$HOMEBREW_PREFIX/share/man:${MANPATH:-}"
	export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
fi

# 2. Populate FPATH for Completions
for dir in \
	"$HOME/.zsh/plugins/zsh-completions/src" \
	${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/share/zsh-completions"} \
	"/usr/share/zsh/site-functions" \
	"/usr/share/zsh/vendor-completions"; do
	[[ -d "$dir" ]] && FPATH="$dir:$FPATH"
done

# Run compinit once per session with -C (skip security audit, use cached dump).
# To force a full rebuild after installing new completions: rm ~/.zcompdump && exec zsh
if [[ -z "$_ZSHRC_COMPINIT_DONE" ]]; then
	autoload -Uz compinit
	compinit -C
	if (( $+functions[compdef] )); then
		compdef _create_ticket create_ticket
	fi
	_ZSHRC_COMPINIT_DONE=1
fi

# 3. FZF Integration (AFTER compinit) — guard avoids 5ms fork on reload
if [[ -z "$_FZF_ZSH_LOADED" ]] && command -v fzf &>/dev/null; then
	eval "$(fzf --zsh)"
	_FZF_ZSH_LOADED=1
fi

# Plugins: load once only — re-sourcing stacks widget wrappers (O(n²) slowdown)
if [[ -z "$_ZSH_PLUGINS_LOADED" ]]; then
	_load_plugin() {
		for file in "$@"; do
			if [[ -f "$file" ]]; then
				source -- "$file"
				return 0
			fi
		done
	}

	# Autosuggestions
	_load_plugin \
		"$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
		"/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
		"/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
		${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"}

	# Syntax Highlighting (must load LAST)
	_load_plugin \
		"/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
		"$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
		"/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
		${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"}

	unfunction _load_plugin
	_ZSH_PLUGINS_LOADED=1
fi

# User tool dirs — prepended so they win over Homebrew/system.
# Order (front -> back): Mason > Cargo > uv/local > Go > Homebrew/system (brew already set)

# 1. nvim Mason binaries (highest priority)
[[ -d "$HOME/.local/share/nvim/mason/bin" ]] && export PATH="$HOME/.local/share/nvim/mason/bin:$PATH"

# 2. Cargo binaries
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# 3. User-local binaries (uv tool installs, pipx, etc.)
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# 4. Go binaries
if command -v go >/dev/null 2>&1; then
	export GOPATH="$(go env GOPATH)"
	[[ -d "$GOPATH/bin" ]] && export PATH="$GOPATH/bin:$PATH"
fi

eval "$(zoxide init zsh)"

# ==============================================================================
# ZSH LINE EDITOR KEYMAP
# ==============================================================================
# zsh auto-selects the vi keymaps when $EDITOR/$VISUAL contains "vi" (ours is
# "nvim"), which leaves Ctrl+A/Ctrl+E as self-insert instead of beginning/end of
# line. Explicitly select emacs mode; this also overrides EDITOR auto-detection.
bindkey -e
