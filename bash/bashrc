# ------------------------------------------------------------------------------
# bashrc — minimal bash counterpart to zsh/zshrc
#
# Derived from zsh/zshrc but ONLY sets the prompt and the PATH (plus the
# PATH-related variables it depends on). No plugins, completions, sourcing of
# other files, shell options, aliases, or key bindings.
#
# Note: bash reads ~/.bashrc for *interactive non-login* shells. Login shells
# are handed off to this file by ~/.bash_profile (see bash/bash_profile).
# ------------------------------------------------------------------------------

# Guard against double-sourcing: an existing ~/.bash_profile may already source
# this file, and bootstrap.sh augments profiles rather than replacing them.
[[ -n "${_DOTFILES_BASHRC_LOADED:-}" ]] && return 0
_DOTFILES_BASHRC_LOADED=1

# ==============================================================================
# PATH
# ==============================================================================
# Priority (highest -> lowest), same as zsh/zshrc:
#   Mason > Cargo > uv/local > Go > Homebrew > system

# 1. Homebrew (macOS + Linux)
HOMEBREW_PREFIX=""
if [[ -d "/opt/homebrew" ]]; then
  HOMEBREW_PREFIX="/opt/homebrew"
elif [[ -d "/usr/local/Homebrew" || -d "/usr/local/Cellar" ]]; then
  HOMEBREW_PREFIX="/usr/local"
elif [[ -d "/home/linuxbrew/.linuxbrew" ]]; then
  HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
fi

if [[ -n "$HOMEBREW_PREFIX" ]]; then
  export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
  # Homebrew Python version exposed as python/python3/pip/pip3 via libexec/bin.
  # Single source of truth for the shell; keep in sync with the Brewfile.
  HOMEBREW_PYTHON_VERSION=3.14
  if [[ -d "$HOMEBREW_PREFIX/opt/python@${HOMEBREW_PYTHON_VERSION}/libexec/bin" ]]; then
    export PATH="$HOMEBREW_PREFIX/opt/python@${HOMEBREW_PYTHON_VERSION}/libexec/bin:$PATH"
  fi
  export MANPATH="$HOMEBREW_PREFIX/share/man:${MANPATH:-}"
  export INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}"
fi

# 2. User tool dirs — prepended so they win over Homebrew/system.
#    Order (front -> back): Mason > Cargo > uv/local > Go > Homebrew/system

# nvim Mason binaries (highest priority)
[[ -d "$HOME/.local/share/nvim/mason/bin" ]] && export PATH="$HOME/.local/share/nvim/mason/bin:$PATH"

# Cargo binaries
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# User-local binaries (uv tool installs, pipx, etc.)
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# Go binaries
if command -v go >/dev/null 2>&1; then
  export GOPATH="$(go env GOPATH)"
  [[ -d "$GOPATH/bin" ]] && export PATH="$GOPATH/bin:$PATH"
fi

# ==============================================================================
# PROMPT
# ==============================================================================
# bash equivalent of the zsh prompt:
#   %F{248}%D{%m/%d} %F{244}%* %F{39}%~ %F{13}%# %f
PS1='\[\e[38;5;248m\]\D{%m/%d} \[\e[38;5;244m\]\t \[\e[38;5;39m\]\w \[\e[38;5;13m\]\$ \[\e[0m\]'

# ==============================================================================
# ALIASES
# ==============================================================================
# Shell-agnostic aliases derived from zsh/aliases.zsh (see bash/aliases.sh).
if [[ -f "$HOME/.dotfiles/bash/aliases.sh" ]]; then
	. "$HOME/.dotfiles/bash/aliases.sh"
fi

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init bash)"; fi

# nutanix-harness: if you delete these lines they will be re-added next time nutanix-harness runs; comment them out instead to disable.
[ -f "${HOME}/.nutanix-harness.rc" ] && source "${HOME}/.nutanix-harness.rc"
alias opencode=nutanix-harness
